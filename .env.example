# Public site + admin panel (Vite). Copy to .env.local to override.

# API base used by the browser. Keep the default "/api/v1" when the site is
# served from the same host as the API (or through the dev proxy below); set
# an absolute URL such as https://api.example.gov.in/api/v1 otherwise.
VITE_API_URL=/api/v1

# Backend the Vite dev / preview server proxies /api and /uploads to.
VITE_DEV_API_TARGET=http://localhost:4200
